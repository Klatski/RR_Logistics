{
  "name": "rr-logistics",
  "version": "2.0.0",
  "private": true,
  "description": "PWA для учёта поездок и аренды автомобилей",
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -k -n BACKEND,FRONTEND -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend run start"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
